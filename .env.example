# ─── Required for production ─────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# Random ≥32 char secret used to sign session cookies
SESSION_SECRET=your-secret-key-here

# Replit Auth (auto-provisioned by Replit when deployed there)
REPL_ID=
ISSUER_URL=https://replit.com/oidc
# REPL_SLUG=
# REPLIT_DOMAINS=

# ─── Environment ────────────────────────────────────────────────────────

# "production" in deploy, "development" locally
NODE_ENV=development

# Server listen port. Replit sets this automatically — leave blank in prod.
# PORT=5000

# ─── Optional integrations ──────────────────────────────────────────────

# OpenAI — only needed if you generate AI scenarios via the admin tools.
# Without it, AI scenario generation endpoints return an error but the rest
# of the app works fine.
# OPENAI_API_KEY=

# Web Push (browser notifications). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Without these, push notifications are silently disabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─── Local dev only — NEVER set in production ───────────────────────────

# Bypasses Replit OIDC and signs you in as a fake "dev-local-user".
# The server hard-fails at startup if this is "true" AND NODE_ENV=production.
# Useful for running the app outside replit.com (your local machine, a
# worktree, etc.) since Replit's OIDC won't work elsewhere.
# DEV_AUTH_BYPASS=true
